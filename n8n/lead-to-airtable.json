        [{ "node": "Normalize Lead", "type": "main", "index": 0 }],
        [{ "node": "Respond 401", "type": "main", "index": 0 }]
      ]
    },
    "Normalize Lead": { "main": [[{ "node": "Is Conversion?", "type": "main", "index": 0 }]] },
    "Is Conversion?": {
      "main": [
        [{ "node": "Find Existing Lead", "type": "main", "index": 0 }],
        [{ "node": "Respond Skipped", "type": "main", "index": 0 }]
      ]
    },
    "Find Existing Lead": { "main": [[{ "node": "Lead Exists?", "type": "main", "index": 0 }]] },
    "Lead Exists?": {
      "main": [
        [{ "node": "Update Lead", "type": "main", "index": 0 }],
        [{ "node": "Create Lead", "type": "main", "index": 0 }]
      ]
    },
    "Update Lead": { "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]] },
    "Create Lead": { "main": [[{ "node": "Respond 200", "type": "main", "index": 0 }]] },
    "Error Trigger": { "main": [[{ "node": "Log Failure", "type": "main", "index": 0 }]] }
  },
  "settings": {
